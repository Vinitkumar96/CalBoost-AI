# Copy to `.env` and fill in. Both `.env` and `.env.local` are gitignored.
#
# ⚠️ Everything prefixed EXPO_PUBLIC_ is compiled into the app binary and readable by anyone
# who downloads it. Public keys only. Server-side secrets go on the Convex deployment
# instead — see the bottom of this file.

# Clerk → API Keys → Publishable key
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# RevenueCat → Apps and providers → Test Store → API key.
# Test Store products live inside RevenueCat, so this exercises real purchases and real
# webhooks with no Apple Developer account. Only ever read in dev builds — a release build
# ignores it and logs an error, because shipping it would give every user a free subscription.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=

# RevenueCat → Apps and providers → your App Store app → PUBLIC SDK key (starts `appl_`).
# NOT the key starting `sk_` — that one is secret and must never appear here.
# Leave empty until the App Store products exist; the paywall runs against its stub until then.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Only if the RevenueCat entitlement IDENTIFIER isn't `premium`. This is the identifier, not
# the display name — RevenueCat's wizard suggests a display name like "CalBoost AI Pro" while
# the identifier underneath is what the SDK matches on.
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=

# OpenAI, used by `lib/openai.ts`.
# TODO: this call should move behind a Convex action before release — a key shipped in the
# binary is extractable from any build.
EXPO_PUBLIC_OPENAI_API_KEY=

# Optional. Without these, `hooks/useSocialAuth.ts` falls back to Clerk's browser SSO flow
# instead of the native Google sheet. Clerk → SSO Connections → Google.
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=

# --- Written by `npx convex dev` into .env.local, not here ---------------------------------
# CONVEX_DEPLOYMENT
# EXPO_PUBLIC_CONVEX_URL
# EXPO_PUBLIC_CONVEX_SITE_URL

# --- Set on the Convex deployment, never in a file -----------------------------------------
# npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<instance>.clerk.accounts.dev
#   Clerk → Configure → JWT Templates → the template named exactly `convex` → Issuer.
#
# npx convex env set REVENUECAT_WEBHOOK_AUTH <openssl rand -hex 32>
#   The same string goes in RevenueCat → Integrations → Webhooks → Authorization header,
#   pointed at https://<deployment>.convex.site/revenuecat-webhook
