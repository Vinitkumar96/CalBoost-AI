EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_cXVhbGl0eS1zbmFpbC05NS5jbGVyay5hY2NvdW50cy5kZXYk

# Native Sign in with Google. Values come from the Google Cloud OAuth clients that the
# Clerk instance is configured with (Clerk Dashboard -> SSO connections -> Google ->
# "Use custom credentials"). Until all three are set, the Google button falls back to
# Clerk's browser SSO flow. The iOS URL scheme is read at prebuild time by the
# @clerk/expo-google-signin config plugin.
# EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=
